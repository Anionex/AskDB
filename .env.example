# LLM API Configuration - Using OpenAI-compatible API
LLM_PROVIDER=openai
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Admin Configuration
# 默认管理员密码（仅在首次创建admin账户时使用）
ADMIN_DEFAULT_PASSWORD=admin123

# Database Configuration - opengauss
# DEFAULT_DB_TYPE=opengauss
# DEFAULT_DB_HOST=localhost
# DEFAULT_DB_PORT=5432
# DEFAULT_DB_NAME=school
# DEFAULT_DB_USER=your_user
# DEFAULT_DB_PASSWORD=your_password

# Database Configuration - mysql
DEFAULT_DB_TYPE=mysql
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=3306
DEFAULT_DB_NAME=school
DEFAULT_DB_USER=root
DEFAULT_DB_PASSWORD=your_password

# Embedding Configuration
# Embedding provider: "openai" (default) or "local"
EMBEDDING_PROVIDER=openai

# OpenAI Embedding 配置（当 EMBEDDING_PROVIDER=openai 时使用）
# EMBEDDING_API_KEY=your_embedding_api_key_here
# EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 本地 Embedding 配置（当 EMBEDDING_PROVIDER=local 时使用）
# LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Feature Switches
ENABLE_SEMANTIC_SEARCH=true
ENABLE_WEB_SEARCH=true
ENABLE_VECTOR_SEARCH=true

# Advanced Configuration
MAX_QUERY_COMPLEXITY=200
WEB_SEARCH_PROVIDER=duckduckgo
